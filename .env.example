# Active LLM provider for routing/grading/hallucination checks ('ollama', 'groq', 'claude', 'grok', 'qwen3', 'openai')
LLM_PROVIDER=groq

# Groq API key (get one at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic API key (get one at console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key (get one at platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone config — index name: rag-knowledge
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=rag-knowledge

# xAI Grok API key (get one at console.x.ai)
GROK_API_KEY=your_grok_api_key_here

# Ollama host (default is localhost — only change if running Ollama remotely)
OLLAMA_HOST=http://localhost:11434
